# 复制为 config/analysis.env，并替换全部路径。
GATK="/path/to/gatk-4.6.0.0/gatk"
SAMTOOLS="/path/to/samtools"
REFERENCE="/path/to/WES_pipeline/Homo_sapiens.GRCh37.dna.primary_assembly.fa"

# 与Snakefile的results_dir衔接：指向results/bam，而不是results父目录。
BAM_DIR="/path/to/SWS_WES/results/bam"
VCF_DIR="/path/to/SWS_WES/results/vcf"
FILTERED_VCF_DIR="/path/to/SWS_WES/results/filtered_vcf"
PAIR_FILE="config/pairs.tsv"

ANNOVAR="/path/to/annovar/table_annovar.pl"
ANNOVAR_DB="/path/to/annovar/humandb"
ANNOVAR_BUILDVER="hg19"
ANNOVAR_PROTOCOL="refGene,gnomad211_exome,clinvar_20220320"
ANNOVAR_OPERATION="g,f,f"
ANNOTATION_DIR="/path/to/SWS_WES/results/annotation"
FILTERED_VARIANTS_DIR="/path/to/SWS_WES/results/candidate_variants"
